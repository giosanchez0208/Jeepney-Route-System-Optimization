# ---------------------------------------------------------------
# Runtime output
# ---------------------------------------------------------------
# Every optimizer run writes a timestamped folder here (telemetry, checkpoints,
# snapshots). Checkpoints are ~70 MB each, so this directory never gets committed.
# Curated artifacts worth keeping are copied into results/ by hand.
/outputs/

# CityGraph / DDM build cache (rebuilt on demand from the .pbf extract).
# Note the leading slash: data/cache/ holds the committed DDM pickles and must
# NOT be caught by this rule.
/.cache/

# ---------------------------------------------------------------
# Python
# ---------------------------------------------------------------
__pycache__/
*.py[cod]
*.pyd
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
build/
dist/
*.egg-info/
.eggs/

# ---------------------------------------------------------------
# Virtual environments
# ---------------------------------------------------------------
.venv/
.venv311/
venv/
env/
Thesis_venv/

# ---------------------------------------------------------------
# Jupyter
# ---------------------------------------------------------------
.ipynb_checkpoints/

# ---------------------------------------------------------------
# Editors / OS
# ---------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*.tmp
.DS_Store
Thumbs.db
Desktop.ini

# ---------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------
# The DirectDemandSampler reads a TomTom API key from the environment.
.env
.env.*
*.key
*.pem
*.p12
*.crt

# ---------------------------------------------------------------
# Logs and heavy exports
# ---------------------------------------------------------------
*.log
logs/
*.graphml
*.gpkg
*.parquet

# ---------------------------------------------------------------
# Local-only working areas (kept on disk, not published)
# ---------------------------------------------------------------
archive/
paper/

# LaTeX source of the thesis manuscript, plus its figure and reference
# binaries. Kept alongside the code for convenience, never published here.
Thesis_Pedestrian_Traffic_Logistics__OEL_/
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.lof
*.lot
*.out
